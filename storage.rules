rules_version = '2';

// Regras do Firebase Storage.
//  - Cabine: qualquer pessoa com o link (QR) VÊ as fotos dessa sessão.
//  - Câmara descartável: qualquer pessoa ENVIA fotos; ninguém as vê até à revelação.
//  - Só quem está na lista de acesso (login Google) consegue LISTAR tudo, a qualquer momento.
//  - Ninguém consegue apagar nem reescrever fotos.
service firebase.storage {
  match /b/{bucket}/o {

    // Quem tem acesso à galeria: lista em Firestore (/acesso/<email>), gerida na própria galeria
    function noivos() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && firestore.exists(/databases/(default)/documents/acesso/$(request.auth.token.email));
    }

    // ⚠️ Hora da revelação da câmara descartável, em milissegundos desde 1970.
    // Igual a descartavel.revelacao em js/config.js. Para calcular:
    //   node -e "console.log(Date.parse('2027-06-13T12:00:00+01:00'))"
    function revelado() {
      return request.time > timestamp.value(1812884400000);
    }

    // ── Cabine ───────────────────────────────────────────
    match /sessoes/{sessao}/{ficheiro} {
      allow get: if sessao.matches('^[0-9]{12}-[a-z0-9]{6}$') || noivos();
      allow create: if sessao.matches('^[0-9]{12}-[a-z0-9]{6}$')
                    && ficheiro.matches('^(tira|tira-mini|foto-[1-4])[.]jpg$')
                    && request.resource.contentType == 'image/jpeg'
                    && request.resource.size < 12 * 1024 * 1024;
      allow update, delete: if false;
    }
    match /sessoes/{caminho=**} {
      allow list: if noivos();
    }

    // ── Câmara descartável ───────────────────────────────
    // Pasta por convidado: "<id do telemóvel>--<nome>", fotos 01, 02, … (+ miniatura).
    // O limite de cada pessoa (5 por defeito) é controlado pela página e pode ser
    // aumentado na galeria dos noivos; aqui só se trava nas 99.
    match /descartavel/{rolo}/{ficheiro} {
      allow get: if revelado() || noivos();
      allow create: if rolo.matches('^[a-z0-9]{8}--[^/]{1,40}$')
                    && ficheiro.matches('^(0[1-9]|[1-9][0-9])(-mini)?[.]jpg$')
                    && request.resource.contentType == 'image/jpeg'
                    && request.resource.size < 6 * 1024 * 1024;
      allow update, delete: if false;
    }
    match /descartavel/{caminho=**} {
      allow list: if revelado() || noivos();
    }

    // Limite de fotos de cada câmara ({"fotos": 10}), definido pelos noivos na galeria.
    // O telemóvel do convidado lê-o para saber quantas fotos ainda tem.
    match /descartavel-limites/{ficheiro} {
      allow get: if ficheiro.matches('^[a-z0-9]{8}[.]json$');
      allow write: if noivos()
                   && ficheiro.matches('^[a-z0-9]{8}[.]json$')
                   && request.resource.size < 1024;
    }
  }
}
